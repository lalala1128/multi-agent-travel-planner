# Offline demo: no model keys and no Redis server required.
API_KEY=
REDIS_URL=
QDRANT_URL=
QDRANT_PATH=data/qdrant
EMBEDDING_MODE=hash
EMBEDDING_DIMENSIONS=256
GENERATION_MODE=template
DEMO_SEED=true

# Optional HTTP semantic embeddings. Changing model/dimensions selects a new collection.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# Optional model-backed RAG summary; the itinerary candidates remain simulated.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

TASK_TTL=86400
CACHE_TTL=600
TASK_TIMEOUT=180
TOOL_TIMEOUT=15
TOOL_ATTEMPTS=2
MAX_ADJUSTMENTS=3
MAX_ACTIVE_TASKS=16
