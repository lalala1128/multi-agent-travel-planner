# 复制为 .env 后填写。不要提交真实密钥。
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 单次模型请求的超时秒数；总尝试次数包含首次请求。
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_ATTEMPTS=3

# 空值表示不启用 API Key；生产环境请设置一条高强度随机值。
API_KEY=
CORS_ALLOW_ORIGINS=http://127.0.0.1:8001
# 为空时不限制 Host；公网部署请填实际域名，多个值用逗号分隔。
ALLOWED_HOSTS=localhost,127.0.0.1

# 本地运行无需设置；Docker Compose 会自动注入服务地址。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
TASK_TTL_SECONDS=86400
CACHE_TTL_SECONDS=600
TASK_MAX_PENDING=8
EMBEDDING_LOCAL_FILES_ONLY=true
# 已下载模型的共享目录；留空时使用当前项目的 .model_cache。
EMBEDDING_CACHE_DIR=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# demo 仅用于本地学习；设置为任何非 demo 值都会拒绝报价，避免伪装实时价格。
TRAVEL_PROVIDER=demo

# 启用 Caddy HTTPS 反向代理时填写已经解析到本机公网 IP 的域名。
DOMAIN=

# Hotelbeds 只读酒店 Availability 查询（测试环境也需要 API Key、Secret 与 mTLS 证书）。
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BASE_URL=https://api-mtls.test.hotelbeds.com
HOTELBEDS_CLIENT_CERT=
HOTELBEDS_CLIENT_KEY=
HOTELBEDS_CLIENT_KEY_PASSWORD=
HOTELBEDS_TIMEOUT_SECONDS=15
